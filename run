#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || true)"
IMAGE_NAME="${DOCKER_IMAGE_NAME:-cs147-verilog-toolchain}"
CONFIG_FILE_HOST="$REPO_ROOT/config.json"
CONFIG_SCRIPT_HOST="$REPO_ROOT/student_config.py"
CONFIG_FILE_CONT="/repo/config.json"
CONFIG_SCRIPT_CONT="/repo/student_config.py"
TEST_FORCE=""

# Normalize paths on MSYS/Git Bash (Windows)
if command -v cygpath >/dev/null 2>&1; then
  SCRIPT_DIR="$(cygpath -u "$SCRIPT_DIR")"
  REPO_ROOT="$(cygpath -u "$REPO_ROOT")"
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "Error: Docker is not installed or not on PATH. Install Docker Desktop and try again." >&2
  exit 1
fi

if [ -z "$REPO_ROOT" ]; then
  echo "Error: run must be executed inside the CS_147_Handouts git repository." >&2
  exit 1
fi

case "$PWD/" in
  "$REPO_ROOT/"*) ;;
  *)
    echo "Error: current directory ($PWD) is not inside the repository root ($REPO_ROOT)." >&2
    exit 1
    ;;
esac

REL_PATH="${PWD#"$REPO_ROOT"}"
REL_PATH="${REL_PATH#/}"
WORKDIR="/repo"
[ -n "$REL_PATH" ] && WORKDIR="/repo/$REL_PATH"

DOCKER_SOCK_VOLUME=()
if [ -S /var/run/docker.sock ]; then
  DOCKER_SOCK_VOLUME=(-v /var/run/docker.sock:/var/run/docker.sock)
fi
TTY_FLAGS=()
if [ -t 0 ] && [ -t 1 ]; then
  TTY_FLAGS=(-it)
fi
TTY_OPTS=()
if [ ${#TTY_FLAGS[@]} -gt 0 ]; then
  TTY_OPTS=("${TTY_FLAGS[@]}")
fi
SOCK_OPTS=()
if [ ${#DOCKER_SOCK_VOLUME[@]} -gt 0 ]; then
  SOCK_OPTS=("${DOCKER_SOCK_VOLUME[@]}")
fi
SELFTEST_LOG_DIR="$REPO_ROOT/assignments/.testing/selftest_logs"
source "$REPO_ROOT/scripts/spinner.sh"
DOCKER_PLATFORM_FLAG="${DOCKER_PLATFORM_FLAG:---platform linux/amd64}"
SIM_PLATFORM_FLAG="${SIM_PLATFORM_FLAG:---platform linux/amd64}"

print_help() {
  cat <<'EOF'
./run commands:
  [Setup & Shell]
    ./run setup                  Build the Docker image (uses DOCKER_IMAGE_NAME override if set), then prompt for your name.
    ./run shell                  Start an interactive shell in the container at the matching repo subdirectory.
    ./run help                   Show this help.
    ./run <cmd>                  Run any command inside the container (e.g., make test, iverilog ...).

  [Tests & Submission]
    ./run test <hw> [sub]        Run assignment testbenches (all subproblems or one if specified).
    ./run submit <assignment|all> Run the assignment submit flow (runs tests, zips, optional host autograder).
    ./run verilog_checker <tgt>  Run Vcheck on an assignment or path (see verilog_checker.sh for details).
    ./run wave_test              Generate VCD waveforms for the .testing mux examples.

  [HW4 Tools]
    ./run assemble <in> <out>    Run the WISC assembler (writes <out>_*.img and <out>.lst).
    ./run simulate <img>         Run the WISC simulator on a loadfile image.

  [Debug]
    ./run generate <name>        Run debug generators (e.g., ./run generate tools).

  [Student Info]
    ./run student_name           View/update the recorded student name.

  [Utilities]
    ./run makeexecutable <path>  Mark a file executable (chmod +x).

  [Cleanup]
    ./run clean logs             Remove local self-test logs (and other clean target items).
    ./run clean ta               Remove root-level *.out artifacts.
    ./run clean docker           Remove toolchain/autograder images (prompts; optional config cleanup).
    ./run clean turnins          Delete generated submission archives (prompts).
    ./run clean student          Reset saved student name (config.json).
    ./run clean all              Run all clean_* targets (default if no subcommand).
EOF
}

if [ "${1:-}" = "help" ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "--help-only" ]; then
  print_help
  exit 0
fi

if [ "${1:-}" = "verilog_checker" ]; then
  shift
  exec docker run --rm $DOCKER_PLATFORM_FLAG ${TTY_OPTS[@]+"${TTY_OPTS[@]}"} -v "$REPO_ROOT:/repo" ${SOCK_OPTS[@]+"${SOCK_OPTS[@]}"} -w "$WORKDIR" "$IMAGE_NAME" bash /repo/verilog_checker.sh "$@"
fi

if [ "${1:-}" = "test" ]; then
  shift
  exec docker run --rm $DOCKER_PLATFORM_FLAG ${TTY_OPTS[@]+"${TTY_OPTS[@]}"} -v "$REPO_ROOT:/repo" ${SOCK_OPTS[@]+"${SOCK_OPTS[@]}"} -w /repo "$IMAGE_NAME" bash /repo/assignments/.testing/test_runner.sh "$@"
fi

if [ "${1:-}" = "assemble" ]; then
  shift
  exec docker run --rm $DOCKER_PLATFORM_FLAG ${TTY_OPTS[@]+"${TTY_OPTS[@]}"} -v "$REPO_ROOT:/repo" ${SOCK_OPTS[@]+"${SOCK_OPTS[@]}"} -w "$WORKDIR" "$IMAGE_NAME" /repo/assignments/tools/assembler/assemble.sh "$@"
fi

if [ "${1:-}" = "simulate" ]; then
  shift
  exec docker run --rm $SIM_PLATFORM_FLAG ${TTY_OPTS[@]+"${TTY_OPTS[@]}"} -v "$REPO_ROOT:/repo" ${SOCK_OPTS[@]+"${SOCK_OPTS[@]}"} -w "$WORKDIR" "$IMAGE_NAME" /repo/assignments/tools/simulator/wiscalculator "$@"
fi

if [ "${1:-}" = "generate" ]; then
  shift
  subcmd="${1:-}"
  if [ -z "$subcmd" ]; then
    echo "Usage: ./run generate <name>" >&2
    echo "Available: tools" >&2
    exit 1
  fi
  shift || true
  case "$subcmd" in
    tools)
      exec docker run --rm $SIM_PLATFORM_FLAG ${TTY_OPTS[@]+"${TTY_OPTS[@]}"} -v "$REPO_ROOT:/repo" ${SOCK_OPTS[@]+"${SOCK_OPTS[@]}"} -w /repo "$IMAGE_NAME" /repo/assignments/tools/TA/assembler_simulator_testing/run_tests.sh "$@"
      ;;
    *)
      echo "Unknown generate target: $subcmd" >&2
      echo "Available: tools" >&2
      exit 1
      ;;
  esac
fi

if [ "${1:-}" = "makeexecutable" ]; then
  shift
  if [ $# -ne 1 ]; then
    echo "Usage: ./run makeexecutable <path>" >&2
    exit 1
  fi
  target_input="$1"
  if [ "${target_input#/}" = "$target_input" ]; then
    target_path="$PWD/$target_input"
  else
    target_path="$target_input"
  fi
  target_dir="$(cd "$(dirname "$target_path")" && pwd -P)"
  target_base="$(basename "$target_path")"
  target_path="$target_dir/$target_base"
  case "$target_path/" in
    "$REPO_ROOT/"*) ;;
    *)
      echo "Error: path must be inside repo: $target_path" >&2
      exit 1
      ;;
  esac
  if [ ! -e "$target_path" ]; then
    echo "Error: file not found: $target_path" >&2
    exit 1
  fi
  chmod +x "$target_path"
  echo "[makeexecutable] chmod +x $target_path"
  exit 0
fi

case "${1:-}" in
  submit)
    target="$1"; shift
    nograde="0"
    justgrade="0"
    submit_verbose="0"
    submit_hash_verbose="0"
    assignment_arg=""
    declare -a extra_make_args=()
    # Parse flags anywhere; first non-flag hw* is the assignment.
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -nograde) nograde="1" ;;
        -justgrade) justgrade="1" ;;
        -v|--verbose) submit_verbose="1" ;;
        -vh) submit_hash_verbose="1" ;;
        all) if [ -z "$assignment_arg" ]; then assignment_arg="$1"; else extra_make_args+=("$1"); fi ;;
        hw[0-9]*) if [ -z "$assignment_arg" ]; then assignment_arg="$1"; else extra_make_args+=("$1"); fi ;;
        *) extra_make_args+=("$1") ;;
      esac
      shift
    done
    if [ -z "$assignment_arg" ]; then
      echo "[submit] assignment name required (e.g., hw01, hw1, or all)" >&2
      exit 1
    fi
    if [ "$assignment_arg" = "all" ]; then
      submit_flags=()
      [ "$nograde" = "1" ] && submit_flags+=("-nograde")
      [ "$justgrade" = "1" ] && submit_flags+=("-justgrade")
      [ "$submit_verbose" = "1" ] && submit_flags+=("-v")
      [ "$submit_hash_verbose" = "1" ] && submit_flags+=("-vh")
      if [ ${#extra_make_args[@]} -gt 0 ]; then
        submit_flags+=("${extra_make_args[@]}")
      fi
      assignments=()
      while IFS= read -r hw; do
        [ -n "$hw" ] && assignments+=("$hw")
      done < <(ls -d "$REPO_ROOT/assignments"/hw[0-9][0-9] 2>/dev/null | xargs -n1 basename | sort)
      if [ ${#assignments[@]} -eq 0 ]; then
        echo "[submit] no assignments found under $REPO_ROOT/assignments" >&2
        exit 1
      fi
      rc=0
      for hw in "${assignments[@]}"; do
        if [ ${#submit_flags[@]} -gt 0 ]; then
          "$REPO_ROOT/run" submit "${submit_flags[@]}" "$hw" || rc=$?
        else
          "$REPO_ROOT/run" submit "$hw" || rc=$?
        fi
        echo
      done
      exit $rc
    fi
    # Normalize hw number (accept hw1 or hw01)
    case "$assignment_arg" in
      hw[0-9]) assignment_arg=$(printf "hw%02d" "${assignment_arg#hw}") ;;
    esac
    if [ ${#extra_make_args[@]} -gt 0 ]; then
      set -- "$assignment_arg" "${extra_make_args[@]}"
    else
      set -- "$assignment_arg"
    fi
    # Run submit inside the container first.
    docker run --rm $DOCKER_PLATFORM_FLAG ${TTY_OPTS[@]+"${TTY_OPTS[@]}"} -v "$REPO_ROOT:/repo" ${SOCK_OPTS[@]+"${SOCK_OPTS[@]}"} -w /repo \
      -e NOGRADE="$nograde" -e JUSTGRADE="$justgrade" -e AG_VERBOSE="$submit_verbose" -e AG_HASH_VERBOSE="$submit_hash_verbose" \
      -e MAKEFLAGS="--no-print-directory -s" "$IMAGE_NAME" make "$target" "$@"
    rc=$?
    if [ $rc -ne 0 ]; then
      exit $rc
    fi
    # Host-side autograder run unless -nograde
    if [ "$nograde" = "1" ]; then
      echo "[submit] host autograder skipped (nograde)"
      exit 0
    fi
    # Normalize hw number (accept hw1 or hw01)
    case "$assignment_arg" in
      hw[0-9]) assignment_arg=$(printf "hw%02d" "${assignment_arg#hw}") ;;
    esac
    marker_path="$REPO_ROOT/assignments/$assignment_arg/.last_submit_zip"
    if [ ! -f "$marker_path" ]; then
      echo "[submit] marker file not found for host autograder: $marker_path" >&2
      exit 1
    fi
    rel_entry=$(cat "$marker_path")
    zip_name="${rel_entry##*/}"
    grader_dir="$REPO_ROOT/assignments/$assignment_arg/Gradescope_Autograder_Template"
    if [ ! -d "$grader_dir" ]; then
      echo "[submit] Gradescope_Autograder_Template not found for $assignment_arg; skipping host autograder." >&2
      exit 1
    fi
    echo "[submit] running host autograder..."
    (cd "$grader_dir" && AG_VERBOSE="$submit_verbose" AG_HASH_VERBOSE="$submit_hash_verbose" ./run grade "test_submissions/$zip_name")
    grade_rc=$?
    echo "[submit] cleaning autograder artifacts..."
    (cd "$grader_dir" && make clean >/dev/null 2>&1 || true)
    exit $grade_rc
    ;;
  clean)
    shift
    clean_target="${1:-all}"
    case "$clean_target" in
      logs)      make_target="clean_logs" ;;
      docker)    make_target="clean_docker" ;;
      turnins)   make_target="clean_turnins" ;;
      student)   make_target="clean_student_name" ;;
      ta)        make_target="clean_ta" ;;
      all)       make_target="clean" ;;
      *) echo "Usage: ./run clean [logs|docker|turnins|student|ta|all]" >&2; exit 1 ;;
    esac
    shift || true
    exec make "$make_target" "$@"
    ;;
  student_name|wave_test)
    target="$1"; shift
    exec docker run --rm $DOCKER_PLATFORM_FLAG ${TTY_OPTS[@]+"${TTY_OPTS[@]}"} -v "$REPO_ROOT:/repo" ${SOCK_OPTS[@]+"${SOCK_OPTS[@]}"} -w /repo "$IMAGE_NAME" make "$target" "$@"
    ;;
esac

get_student_name_host() {
  python3 - "$CONFIG_FILE_HOST" <<'PY'
import json, sys
path = sys.argv[1]
try:
    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)
    name = data.get("student", {}).get("current_name", "") or ""
    print(name)
except FileNotFoundError:
    print("")
PY
}

set_student_name_host() {
  python3 - "$CONFIG_FILE_HOST" "$1" <<'PY'
import json, sys
path = sys.argv[1]
name = sys.argv[2]
try:
    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)
except FileNotFoundError:
    data = {}
data.setdefault("student", {})
data["student"]["current_name"] = name
data.setdefault("previous_names", data.get("student", {}).get("previous_names", []))
with open(path, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2, sort_keys=False)
    f.write("\n")
PY
}

ensure_student_name() {
  # Uses container python, so call after image exists.
  local preset_name="${1:-}"
  if [ -n "$preset_name" ]; then
    docker run --rm $DOCKER_PLATFORM_FLAG -v "$REPO_ROOT:/repo" -w /repo "$IMAGE_NAME" python3 "$CONFIG_SCRIPT_CONT" --config "$CONFIG_FILE_CONT" set --name "$preset_name"
    echo "Recorded student name: $preset_name"
    return
  fi
  current_name="$(docker run --rm $DOCKER_PLATFORM_FLAG -v "$REPO_ROOT:/repo" -w /repo "$IMAGE_NAME" python3 "$CONFIG_SCRIPT_CONT" --config "$CONFIG_FILE_CONT" current 2>/dev/null || true)"
  if [ -n "$current_name" ]; then
    echo "Student name: $current_name"
    return
  fi
  printf "Enter your name (for submissions): "
  read -r new_name
  if [ -z "$new_name" ]; then
    echo "Name cannot be empty." >&2
    exit 1
  fi
  docker run --rm $DOCKER_PLATFORM_FLAG -v "$REPO_ROOT:/repo" -w /repo "$IMAGE_NAME" python3 "$CONFIG_SCRIPT_CONT" --config "$CONFIG_FILE_CONT" set --name "$new_name"
  echo "Recorded student name: $new_name"
}

if [ "${1:-}" = "setup" ]; then
  shift
  preset_name=""
  existing_name="$(get_student_name_host)"
  if [ -n "$existing_name" ]; then
    echo "Student name: $existing_name"
    printf "Change name? [y/N]: "
    read -r change_name
    case "$change_name" in
      y|Y|yes|YES)
        ;;
      *)
        preset_name="$existing_name"
        ;;
    esac
  fi
  if [ -z "$preset_name" ]; then
    while [ -z "$preset_name" ]; do
      printf "Enter your name (for submissions): "
      read -r preset_name
      if [ -z "$preset_name" ]; then
        echo "Name cannot be empty." >&2
      fi
    done
  fi
  set_student_name_host "$preset_name"
  while [ $# -gt 0 ]; do
    case "$1" in
      --test-force=*)
        TEST_FORCE="${1#*=}"
        ;;
      *)
        echo "Unknown setup option: $1" >&2
        exit 1
        ;;
    esac
    shift
  done
  if [ -f "$REPO_ROOT/assignments/tools/assembler/assemble.sh" ]; then
    chmod +x "$REPO_ROOT/assignments/tools/assembler/assemble.sh"
  fi
  if [ -f "$REPO_ROOT/assignments/tools/simulator/wiscalculator" ]; then
    chmod +x "$REPO_ROOT/assignments/tools/simulator/wiscalculator"
  fi
  echo "Building Docker image '$IMAGE_NAME'..."
  if [ -n "$DOCKER_PLATFORM_FLAG" ]; then
    if docker buildx version >/dev/null 2>&1; then
      docker buildx build --platform linux/amd64 --load -t "$IMAGE_NAME" -f "$REPO_ROOT/docker/Dockerfile" "$REPO_ROOT"
    else
      echo "Error: docker buildx not available; cannot build amd64 image." >&2
      echo "Enable Buildx:" >&2
      echo "  docker buildx create --use --name cs147-builder" >&2
      echo "  docker buildx inspect --bootstrap" >&2
      exit 1
    fi
  else
    docker build -t "$IMAGE_NAME" -f "$REPO_ROOT/docker/Dockerfile" "$REPO_ROOT"
  fi
  echo "Docker image '$IMAGE_NAME' is ready."
  ensure_student_name "$preset_name"
  if [ -f "$REPO_ROOT/assignments/tools/assembler/Assemble.java" ]; then
    echo "Compiling assembler classes..."
    docker run --rm $DOCKER_PLATFORM_FLAG -v "$REPO_ROOT:/repo" -w /repo "$IMAGE_NAME" bash -lc "cd /repo/assignments/tools/assembler && javac Assemble.java AssemblyLine.java Assemble4096.java"
  fi
  echo "------------------------------------------------------------"
  echo "[SELF-TEST] .testing"
  echo "============================================================"
  mkdir -p "$SELFTEST_LOG_DIR"
  attempt=1
  set +e  # allow retries even when commands fail inside the loop
  while [ $attempt -le 3 ]; do
    echo "---------------- attempt $attempt/3 ----------------"
    log_file="$SELFTEST_LOG_DIR/.testing_selftest_attempt${attempt}.log"
    if run_with_spinner "Self-test attempt $attempt" bash -lc "docker run --rm $DOCKER_PLATFORM_FLAG -v \"$REPO_ROOT:/repo\" ${DOCKER_SOCK_VOLUME[*]} -w /repo \"$IMAGE_NAME\" bash -lc \"set -e; make submit .testing ${TEST_FORCE:+FORCE_RESULT=\\\"$TEST_FORCE\\\"}\" >\"$log_file\" 2>&1"; then
      cat "$log_file"
      echo "============================================================"
      echo "[SELF-TEST] PASS"
      echo "------------------------------------------------------------"
      exit 0
    else
      if [ $attempt -lt 3 ]; then
        echo "(attempt $attempt failed; output saved to $log_file)"
      else
        cat "$log_file"
      fi
    fi
    echo "---------------- end attempt $attempt ----------------"
    attempt=$((attempt+1))
  done
  set -e
  echo "============================================================"
  echo "[SELF-TEST] FAIL after 3 attempts. Please contact the instructor."
  if ls "$SELFTEST_LOG_DIR"/.testing_selftest_attempt*.log >/dev/null 2>&1; then
    echo "Saved logs:"
    ls -1 "$SELFTEST_LOG_DIR"/.testing_selftest_attempt*.log
    zip_path="$SELFTEST_LOG_DIR/selftest_logs.zip"
    if command -v zip >/dev/null 2>&1; then
      rm -f "$zip_path"
      (cd "$SELFTEST_LOG_DIR" && zip -q "selftest_logs.zip" .testing_selftest_attempt*.log >/dev/null 2>&1)
      if [ -f "$zip_path" ]; then
        echo "Log bundle: $zip_path"
      fi
    fi
  fi
  echo "------------------------------------------------------------"
  exit 1
fi

if ! docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
  echo "Error: Docker image '$IMAGE_NAME' not found. Run './run setup' first." >&2
  exit 1
fi

if [ $# -eq 0 ]; then
  set -- shell
fi

if [ "$1" = "shell" ]; then
  shift
  exec docker run --rm $DOCKER_PLATFORM_FLAG "${TTY_FLAGS[@]}" -v "$REPO_ROOT:/repo" "${DOCKER_SOCK_VOLUME[@]}" -w "$WORKDIR" "$IMAGE_NAME" bash "$@"
fi

exec docker run --rm $DOCKER_PLATFORM_FLAG "${TTY_FLAGS[@]}" -v "$REPO_ROOT:/repo" "${DOCKER_SOCK_VOLUME[@]}" -w "$WORKDIR" "$IMAGE_NAME" "$@"
