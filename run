#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Support Docker-in-Docker: if HOST_REPO_ROOT is set, we're inside a container
# REPO_ROOT = host path (for Docker volume mounts)
# LOCAL_REPO_ROOT = container path (for local file access)
if [ -n "${HOST_REPO_ROOT:-}" ]; then
  REPO_ROOT="$HOST_REPO_ROOT"
  LOCAL_REPO_ROOT="/repo"
else
  REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || true)"
  LOCAL_REPO_ROOT="$REPO_ROOT"
fi
IMAGE_NAME="${DOCKER_IMAGE_NAME:-cs147-verilog-toolchain}"
CONFIG_FILE_HOST="$LOCAL_REPO_ROOT/config.json"
CONFIG_SCRIPT_HOST="$LOCAL_REPO_ROOT/scripts/student_config.py"
CONFIG_FILE_CONT="/repo/config.json"
CONFIG_SCRIPT_CONT="/repo/scripts/student_config.py"
TEST_FORCE=""

# Normalize paths on MSYS/Git Bash (Windows)
if command -v cygpath >/dev/null 2>&1; then
  SCRIPT_DIR="$(cygpath -u "$SCRIPT_DIR")"
  REPO_ROOT="$(cygpath -u "$REPO_ROOT")"
fi

get_student_name_host() {
  python3 - "$CONFIG_FILE_HOST" <<'PY'
import json, sys
path = sys.argv[1]
try:
    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)
    name = data.get("student", {}).get("current_name", "") or ""
    print(name)
except FileNotFoundError:
    print("")
PY
}

set_student_name_host() {
  python3 - "$CONFIG_FILE_HOST" "$1" <<'PY'
import json, sys
path = sys.argv[1]
name = sys.argv[2]
try:
    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)
except FileNotFoundError:
    data = {}
data.setdefault("student", {})
data["student"]["current_name"] = name
data.setdefault("previous_names", data.get("student", {}).get("previous_names", []))
with open(path, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2, sort_keys=False)
    f.write("\n")
PY
}

get_student_id_host() {
  python3 - "$CONFIG_FILE_HOST" <<'PY'
import json, sys
path = sys.argv[1]
try:
    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)
    value = data.get("student", {}).get("current_id", "") or ""
    print(value)
except FileNotFoundError:
    print("")
PY
}

set_student_id_host() {
  python3 - "$CONFIG_FILE_HOST" "$1" <<'PY'
import json, sys
path = sys.argv[1]
value = sys.argv[2]
try:
    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)
except FileNotFoundError:
    data = {}
data.setdefault("student", {})
data["student"]["current_id"] = value
data.setdefault("previous_ids", data.get("student", {}).get("previous_ids", []))
with open(path, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2, sort_keys=False)
    f.write("\n")
PY
}

ensure_config_writable() {
  local cfg_path="$1"
  local cfg_dir
  cfg_dir="$(dirname "$cfg_path")"
  if [ -e "$cfg_path" ]; then
    if [ ! -w "$cfg_path" ]; then
      echo "Warning: config.json is not writable: $cfg_path" >&2
      if command -v sudo >/dev/null 2>&1; then
        printf "Fix permissions now using sudo? [y/N]: " >&2
        read -r fix_confirm
        case "$fix_confirm" in
          y|Y|yes|YES)
            sudo chown "$USER:$USER" "$cfg_path" && chmod u+rw "$cfg_path" || {
              echo "Error: failed to fix permissions for $cfg_path" >&2
              exit 1
            }
            ;;
          *)
            echo "Error: config.json is not writable: $cfg_path" >&2
            echo "Fix (WSL/Linux): sudo chown $USER:$USER \"$cfg_path\" && chmod u+rw \"$cfg_path\"" >&2
            exit 1
            ;;
        esac
      else
        echo "Error: config.json is not writable: $cfg_path" >&2
        echo "Fix (WSL/Linux): sudo chown $USER:$USER \"$cfg_path\" && chmod u+rw \"$cfg_path\"" >&2
        exit 1
      fi
    fi
  else
    if [ ! -w "$cfg_dir" ]; then
      echo "Warning: config.json cannot be created in: $cfg_dir" >&2
      if command -v sudo >/dev/null 2>&1; then
        printf "Fix permissions now using sudo? [y/N]: " >&2
        read -r fix_confirm
        case "$fix_confirm" in
          y|Y|yes|YES)
            sudo chown -R "$USER:$USER" "$cfg_dir" || {
              echo "Error: failed to fix permissions for $cfg_dir" >&2
              exit 1
            }
            ;;
          *)
            echo "Error: config.json cannot be created in: $cfg_dir" >&2
            echo "Fix (WSL/Linux): sudo chown -R $USER:$USER \"$cfg_dir\"" >&2
            exit 1
            ;;
        esac
      else
        echo "Error: config.json cannot be created in: $cfg_dir" >&2
        echo "Fix (WSL/Linux): sudo chown -R $USER:$USER \"$cfg_dir\"" >&2
        exit 1
      fi
    fi
  fi
}

if ! command -v docker >/dev/null 2>&1; then
  echo "Error: Docker is not installed or not on PATH. Install Docker Desktop and try again." >&2
  exit 1
fi

if [ -z "$REPO_ROOT" ]; then
  echo "Error: run must be executed inside the CS_147_Handouts git repository." >&2
  exit 1
fi

# Skip PWD validation when inside container (using HOST_REPO_ROOT)
if [ -z "${HOST_REPO_ROOT:-}" ]; then
  case "$PWD/" in
    "$REPO_ROOT/"*) ;;
    *)
      echo "Error: current directory ($PWD) is not inside the repository root ($REPO_ROOT)." >&2
      exit 1
      ;;
  esac
  REL_PATH="${PWD#"$REPO_ROOT"}"
  REL_PATH="${REL_PATH#/}"
  WORKDIR="/repo"
  [ -n "$REL_PATH" ] && WORKDIR="/repo/$REL_PATH"
else
  # Inside container: use current directory relative to /repo
  WORKDIR="$PWD"
fi

DOCKER_SOCK_VOLUME=()
if [ -S /var/run/docker.sock ]; then
  DOCKER_SOCK_VOLUME=(-v /var/run/docker.sock:/var/run/docker.sock)
fi
TTY_FLAGS=()
if [ -t 0 ] && [ -t 1 ]; then
  TTY_FLAGS=(-it)
fi
TTY_OPTS=()
if [ ${#TTY_FLAGS[@]} -gt 0 ]; then
  TTY_OPTS=("${TTY_FLAGS[@]}")
fi
SOCK_OPTS=()
if [ ${#DOCKER_SOCK_VOLUME[@]} -gt 0 ]; then
  SOCK_OPTS=("${DOCKER_SOCK_VOLUME[@]}")
fi
SELFTEST_LOG_DIR="$LOCAL_REPO_ROOT/assignments/.testing/selftest_logs"
source "$LOCAL_REPO_ROOT/scripts/spinner.sh"
DOCKER_PLATFORM_FLAG="${DOCKER_PLATFORM_FLAG:---platform linux/amd64}"
SIM_PLATFORM_FLAG="${SIM_PLATFORM_FLAG:---platform linux/amd64}"

print_help() {
  cat <<'EOF'
./run commands:
  [Setup & Shell]
    ./run setup                  Build the Docker image (uses DOCKER_IMAGE_NAME override if set), then prompt for your name.
    ./run shell                  Start an interactive shell in the container at the matching repo subdirectory.
    ./run help                   Show this help.
    ./run <cmd>                  Run any command inside the container (e.g., make test, iverilog ...).

  [Tests & Submission]
    ./run test <hw> [sub]        Run assignment testbenches (all subproblems or one if specified).
    ./run build_submission <assignment|all> Run the assignment submission build flow (preferred).
    ./run submit <assignment|all> Run the assignment submit flow (compat; same as build_submission).
    ./run verilog_checker <tgt>  Run Vcheck on an assignment or path (see scripts/verilog_checker/verilog_checker.sh for details).
    ./run wave_test              Generate VCD waveforms for the .testing mux examples.

  [HW4 Tools]
    ./run assemble <in> <out>    Run the WISC assembler (writes <out>_*.img and <out>.lst).
    ./run simulate <img>         Run the WISC simulator on a loadfile image.

  [Debug]
    ./run generate <name>        Run debug generators (e.g., ./run generate tools).
    ./run generate writeup [hw]  Rebuild writeup PDFs locally (not intended for students).
    ./run generate writeup rules Rebuild the Verilog rules PDF locally (not intended for students).
    ./run generate vpn           Bring up VPN sidecar and run connectivity check (local-only).
    ./run vpn up [args]          Start VPN sidecar and leave it running.
    ./run vpn down               Stop VPN sidecar.

  [Student Info]
    ./run student name [value]   View/update the recorded student name.
    ./run student id [value]     View/update the recorded student ID (VPN username).
    ./run student_name           View/update the recorded student name (legacy).

  [Utilities]
    ./run makeexecutable <path>  Mark a file executable (chmod +x).

  [Cleanup]
    ./run clean logs             Remove local self-test logs (and other clean target items).
    ./run clean ta               Remove root-level *.out artifacts.
    ./run clean docker           Remove toolchain/autograder images (prompts; optional config cleanup).
    ./run clean turnins          Delete generated submission archives (prompts).
    ./run clean student          Reset saved student name (config.json).
    ./run clean all              Run all clean_* targets (default if no subcommand).
EOF
}

if [ "${1:-}" = "help" ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "--help-only" ]; then
  print_help
  exit 0
fi

if [ "${1:-}" = "vpn" ]; then
  shift
  case "${1:-}" in
    up)
      shift || true
      exec "$REPO_ROOT/run" generate vpn --sso-host --keepopen --no-wait "$@"
      ;;
    down)
      shift || true
      exec docker compose -f "$REPO_ROOT/docker/vpn_sidecar/docker-compose.yml" down
      ;;
    *)
      echo "Usage: ./run vpn [up|down]" >&2
      exit 1
      ;;
  esac
fi

if [ "${1:-}" = "verilog_checker" ]; then
  shift
  exec docker run --rm $DOCKER_PLATFORM_FLAG ${TTY_OPTS[@]+"${TTY_OPTS[@]}"} -v "$REPO_ROOT:/repo" ${SOCK_OPTS[@]+"${SOCK_OPTS[@]}"} -w "$WORKDIR" "$IMAGE_NAME" bash /repo/scripts/verilog_checker/verilog_checker.sh "$@"
fi

if [ "${1:-}" = "test" ]; then
  shift
  exec docker run --rm $DOCKER_PLATFORM_FLAG ${TTY_OPTS[@]+"${TTY_OPTS[@]}"} -v "$REPO_ROOT:/repo" ${SOCK_OPTS[@]+"${SOCK_OPTS[@]}"} -w /repo "$IMAGE_NAME" bash /repo/assignments/.testing/test_runner.sh "$@"
fi

if [ "${1:-}" = "assemble" ]; then
  shift
  exec docker run --rm $DOCKER_PLATFORM_FLAG ${TTY_OPTS[@]+"${TTY_OPTS[@]}"} -v "$REPO_ROOT:/repo" ${SOCK_OPTS[@]+"${SOCK_OPTS[@]}"} -w "$WORKDIR" "$IMAGE_NAME" /repo/assignments/tools/assembler/assemble.sh "$@"
fi

if [ "${1:-}" = "simulate" ]; then
  shift
  exec docker run --rm $SIM_PLATFORM_FLAG ${TTY_OPTS[@]+"${TTY_OPTS[@]}"} -v "$REPO_ROOT:/repo" ${SOCK_OPTS[@]+"${SOCK_OPTS[@]}"} -w "$WORKDIR" "$IMAGE_NAME" /repo/assignments/tools/simulator/wiscalculator "$@"
fi

if [ "${1:-}" = "generate" ]; then
  shift
  subcmd="${1:-}"
  if [ -z "$subcmd" ]; then
    echo "Usage: ./run generate <name>" >&2
    echo "Available: tools, writeup, vpn" >&2
    exit 1
  fi
  shift || true
  case "$subcmd" in
    tools)
      exec docker run --rm $SIM_PLATFORM_FLAG ${TTY_OPTS[@]+"${TTY_OPTS[@]}"} -v "$REPO_ROOT:/repo" ${SOCK_OPTS[@]+"${SOCK_OPTS[@]}"} -w /repo "$IMAGE_NAME" /repo/assignments/tools/TA/assembler_simulator_testing/run_tests.sh "$@"
      ;;
    vpn)
      echo "[TEST] VPN Sidecar"
      vpn_compose="$REPO_ROOT/docker/vpn_sidecar/docker-compose.yml"
      vpn_url="http://fineg02.engr.sjsu.edu/labcond.html"
      vpn_google_url="https://www.google.com"
      vpn_status="pass"
      vpn_fail_reason=""
      vpn_compose_output=""
      VPN_GROUP="${VPN_GROUP:-Student-SSO}"
      VPN_ENDPOINT="${VPN_ENDPOINT:-vpn.sjsu.edu}"
      VPN_PASS="${VPN_PASS:-}"
      keep_open="false"
      no_wait="false"
      sso_mode="false"
      sso_host="false"
      open_auth_url="true"
      while [ $# -gt 0 ]; do
        case "$1" in
          -keepopen)
            keep_open="true"
            shift || true
            ;;
          --no-wait)
            no_wait="true"
            shift || true
            ;;
          --sso|-sso)
            sso_mode="true"
            shift || true
            ;;
          --sso-host)
            sso_mode="true"
            sso_host="true"
            shift || true
            ;;
          --no-open)
            open_auth_url="false"
            shift || true
            ;;
          *)
            break
            ;;
        esac
      done
      print_vpn_fail() {
        local msg="$1"
        vpn_status="fail"
        vpn_fail_reason="$msg"
        echo "  [FAIL] $msg"
      }
      if [ ! -f "$vpn_compose" ]; then
        print_vpn_fail "vpn_sidecar compose file missing: $vpn_compose"
      else
        if ! docker info >/dev/null 2>&1; then
          print_vpn_fail "Docker daemon not running or not accessible."
        fi
        if [ "$vpn_status" = "pass" ] && ! docker compose version >/dev/null 2>&1; then
          print_vpn_fail "docker compose is not available. Install/enable Docker Compose."
        fi
        if [ "$vpn_status" = "pass" ]; then
          vpn_image="$(awk '/^[[:space:]]*image:[[:space:]]*/{print $2; exit}' "$vpn_compose" 2>/dev/null || true)"
          if [ -n "$vpn_image" ]; then
            if ! docker pull "$vpn_image" >/dev/null 2>&1; then
              print_vpn_fail "VPN image pull failed: $vpn_image"
            fi
          else
            print_vpn_fail "VPN image not found in compose file."
          fi
        fi
        if [ "$vpn_status" = "pass" ]; then
          if [ -z "${VPN_USER:-}" ]; then
            VPN_USER="$(get_student_id_host)"
          fi
          if [ -z "${VPN_USER:-}" ]; then
            printf "VPN username: "
            read -r VPN_USER
            if [ -n "$VPN_USER" ]; then
              ensure_config_writable "$CONFIG_FILE_HOST"
              set_student_id_host "$VPN_USER"
            fi
          fi
          if [ "$sso_mode" != "true" ]; then
            if [ -z "${VPN_PASS:-}" ]; then
              printf "VPN password: "
              read -r -s VPN_PASS
              echo
            fi
          fi
          if [ -z "$VPN_USER" ] || { [ "$sso_mode" != "true" ] && [ -z "$VPN_PASS" ]; }; then
            print_vpn_fail "VPN credentials not provided."
          fi
        fi
      fi
      if [ "$vpn_status" = "pass" ]; then
        VPN_COOKIE=""
        if [ "$sso_mode" = "true" ]; then
          echo "  [INFO] Starting SSO authentication (Duo)..."
          auth_log="$(mktemp)"
          auth_cmd='echo "[vpn] auth endpoint=$VPN_ENDPOINT user=$VPN_USER group=$VPN_GROUP" >&2; \
openconnect --protocol=anyconnect --user="$VPN_USER" --authgroup="$VPN_GROUP" --useragent="AnyConnect" -vvv --authenticate "$VPN_ENDPOINT"'
          if [ "$sso_host" = "true" ]; then
            if ! command -v openconnect >/dev/null 2>&1; then
              print_vpn_fail "Host openconnect not found (required for --sso-host)."
            else
              if openconnect --protocol=anyconnect --user="$VPN_USER" --authgroup="$VPN_GROUP" --useragent="AnyConnect" -vvv --authenticate "$VPN_ENDPOINT" \
                2>&1 | tee "$auth_log"; then
                :
              else
                print_vpn_fail "SSO authentication failed."
              fi
            fi
          else
            if docker run --rm $DOCKER_PLATFORM_FLAG -it --entrypoint /bin/sh \
              -e VPN_ENDPOINT="$VPN_ENDPOINT" \
              -e VPN_USER="$VPN_USER" \
              -e VPN_GROUP="$VPN_GROUP" \
              "$vpn_image" -lc \
              "$auth_cmd" \
              2>&1 | tee "$auth_log"; then
              :
            else
              print_vpn_fail "SSO authentication failed."
            fi
            auth_url="$(grep -Eo 'Failed to spawn external browser for https?://[^ ]+' "$auth_log" | head -n1 | sed 's/^.*for //' || true)"
            if [ -z "$auth_url" ]; then
              auth_url="$(grep -Eo 'https?://[^ ]+' "$auth_log" | head -n1 || true)"
            fi
            if [ -n "$auth_url" ]; then
              echo "  [INFO] SSO login URL: $auth_url"
              if [ "$open_auth_url" = "true" ]; then
                if command -v open >/dev/null 2>&1; then
                  open "$auth_url" >/dev/null 2>&1 || true
                elif command -v xdg-open >/dev/null 2>&1; then
                  xdg-open "$auth_url" >/dev/null 2>&1 || true
                fi
              fi
            fi
          fi
          VPN_COOKIE="$(grep -Eo 'COOKIE=.*' "$auth_log" | head -n1 | sed -E 's/^COOKIE=//; s/^'\''//; s/'\''$//' || true)"
          if [ -z "$VPN_COOKIE" ]; then
            print_vpn_fail "SSO cookie not captured."
          fi
          rm -f "$auth_log"
        fi
        if [ "$vpn_status" != "pass" ]; then
          echo "  [Result: $(printf '%s' "$vpn_status" | tr '[:lower:]' '[:upper:]')]"
          exit 1
        fi
        echo "  [INFO] Starting VPN sidecar (local-only)"
        echo "  [INFO] VPN params: endpoint=${VPN_ENDPOINT} user=${VPN_USER} group=${VPN_GROUP:-<none>} pass=<redacted>"
        vpn_compose_output="$(
          VPN_ENDPOINT="$VPN_ENDPOINT" VPN_USER="$VPN_USER" VPN_PASS="$VPN_PASS" VPN_GROUP="${VPN_GROUP:-}" VPN_COOKIE="${VPN_COOKIE:-}" \
            docker compose -f "$vpn_compose" up -d --remove-orphans 2>&1
        )" || true
        if [ -n "$vpn_compose_output" ] && ! docker compose -f "$vpn_compose" ps >/dev/null 2>&1; then
          if echo "$vpn_compose_output" | rg -qi "Cannot connect to the Docker daemon"; then
            print_vpn_fail "VPN sidecar failed to start (Docker daemon not reachable)."
          else
            print_vpn_fail "VPN sidecar failed to start (docker compose)."
          fi
          echo "  [INFO] docker compose output:"
          printf "%s\n" "$vpn_compose_output" | sed 's/^/    /'
          echo "  [INFO] Sidecar logs (tail):"
          docker logs --tail=200 cs147-vpn-sidecar 2>/dev/null | sed 's/^/    /' || true
        else
          echo "  [OK] VPN sidecar started"
          sleep 3
          if ! docker ps --filter "name=cs147-vpn-sidecar" --filter "status=running" --format '{{.ID}}' | rg -q '.'; then
            print_vpn_fail "VPN login failed or container exited."
            echo "  [INFO] Sidecar logs (tail):"
            docker logs --tail=200 cs147-vpn-sidecar 2>/dev/null | sed 's/^/    /' || true
            docker compose -f "$vpn_compose" down >/dev/null 2>&1 || true
            echo "  [Result: $(printf '%s' "$vpn_status" | tr '[:lower:]' '[:upper:]')]"
            exit 1
          fi
          if docker run --rm --network container:cs147-vpn-sidecar curlimages/curl:8.5.0 -I -m 10 "$vpn_google_url" >/dev/null 2>&1; then
            echo "  [OK] VPN connectivity check (google.com)"
          else
            echo "  [FAIL] VPN connectivity check (google.com)"
          fi
          if docker run --rm --network container:cs147-vpn-sidecar curlimages/curl:8.5.0 -I -m 10 "$vpn_url" >/dev/null 2>&1; then
            echo "  [OK] VPN connectivity check (intranet)"
          else
            print_vpn_fail "VPN connectivity check failed (intranet)."
            echo "  [INFO] Sidecar logs (tail):"
            docker logs --tail=200 cs147-vpn-sidecar 2>/dev/null | sed 's/^/    /' || true
          fi
          if [ "$keep_open" = "true" ]; then
            if [ "$no_wait" = "true" ]; then
              echo "  [INFO] VPN sidecar is running."
              echo "  [INFO] Use './run vpn down' to stop it."
            else
              echo "  [INFO] VPN sidecar is running. Press Enter to stop."
              trap 'docker compose -f "$vpn_compose" down >/dev/null 2>&1 || true; exit 0' INT
              read -r _
              docker compose -f "$vpn_compose" down >/dev/null 2>&1 || true
            fi
          fi
          if [ "$keep_open" != "true" ]; then
            docker compose -f "$vpn_compose" down >/dev/null 2>&1 || true
          fi
        fi
      fi
      echo "  [Result: $(printf '%s' "$vpn_status" | tr '[:lower:]' '[:upper:]')]"
      exit $([ "$vpn_status" = "pass" ] && echo 0 || echo 1)
      ;;
    writeup)
      target_hw="${1:-}"
      if [ "$target_hw" = "rules" ]; then
        exec docker run --rm $SIM_PLATFORM_FLAG ${TTY_OPTS[@]+"${TTY_OPTS[@]}"} -v "$REPO_ROOT:/repo" ${SOCK_OPTS[@]+"${SOCK_OPTS[@]}"} -w /repo "$IMAGE_NAME" bash /repo/scripts/writeup/build_writeup.sh rules
      fi
      if [ -z "$target_hw" ]; then
        echo "[writeup] No assignment specified."
        echo "[writeup] This will overwrite all existing writeup PDFs."
        printf "Proceed? [Y/n]: "
        read -r confirm
        case "$confirm" in
          ""|y|Y|yes|YES) ;;
          *) echo "[writeup] Aborted."; exit 1 ;;
        esac
        hw_list=()
        while IFS= read -r hw; do
          [ -n "$hw" ] && hw_list+=("$hw")
        done < <(ls -d "$REPO_ROOT/assignments"/hw[0-9][0-9] 2>/dev/null | xargs -n1 basename | sort)
        if [ ${#hw_list[@]} -eq 0 ]; then
          echo "[writeup] No assignments found under $REPO_ROOT/assignments." >&2
          exit 1
        fi
        exec docker run --rm $SIM_PLATFORM_FLAG ${TTY_OPTS[@]+"${TTY_OPTS[@]}"} -v "$REPO_ROOT:/repo" ${SOCK_OPTS[@]+"${SOCK_OPTS[@]}"} -w /repo "$IMAGE_NAME" bash /repo/scripts/writeup/build_writeup.sh "${hw_list[@]}"
      fi
      exec docker run --rm $SIM_PLATFORM_FLAG ${TTY_OPTS[@]+"${TTY_OPTS[@]}"} -v "$REPO_ROOT:/repo" ${SOCK_OPTS[@]+"${SOCK_OPTS[@]}"} -w /repo "$IMAGE_NAME" bash /repo/scripts/writeup/build_writeup.sh "$target_hw"
      ;;
    *)
      echo "Unknown generate target: $subcmd" >&2
      echo "Available: tools, writeup, vpn" >&2
      exit 1
      ;;
  esac
fi

if [ "${1:-}" = "makeexecutable" ]; then
  shift
  if [ $# -ne 1 ]; then
    echo "Usage: ./run makeexecutable <path>" >&2
    exit 1
  fi
  target_input="$1"
  if [ "${target_input#/}" = "$target_input" ]; then
    target_path="$PWD/$target_input"
  else
    target_path="$target_input"
  fi
  target_dir="$(cd "$(dirname "$target_path")" && pwd -P)"
  target_base="$(basename "$target_path")"
  target_path="$target_dir/$target_base"
  case "$target_path/" in
    "$REPO_ROOT/"*) ;;
    *)
      echo "Error: path must be inside repo: $target_path" >&2
      exit 1
      ;;
  esac
  if [ ! -e "$target_path" ]; then
    echo "Error: file not found: $target_path" >&2
    exit 1
  fi
  chmod +x "$target_path"
  echo "[makeexecutable] chmod +x $target_path"
  exit 0
fi

case "${1:-}" in
  build_submission|submit)
    target="submit"
    shift
    nograde="0"
    justgrade="0"
    submit_verbose="0"
    submit_hash_verbose="0"
    assignment_arg=""
    declare -a extra_make_args=()
    # Parse flags anywhere; first non-flag hw* is the assignment.
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -nograde) nograde="1" ;;
        -justgrade) justgrade="1" ;;
        -v|--verbose) submit_verbose="1" ;;
        -vh) submit_hash_verbose="1" ;;
        all) if [ -z "$assignment_arg" ]; then assignment_arg="$1"; else extra_make_args+=("$1"); fi ;;
        hw[0-9]*) if [ -z "$assignment_arg" ]; then assignment_arg="$1"; else extra_make_args+=("$1"); fi ;;
        *) extra_make_args+=("$1") ;;
      esac
      shift
    done
    if [ -z "$assignment_arg" ]; then
      echo "[submit] assignment name required (e.g., hw01, hw1, or all)" >&2
      exit 1
    fi
    if [ "$assignment_arg" = "all" ]; then
      submit_flags=()
      [ "$nograde" = "1" ] && submit_flags+=("-nograde")
      [ "$justgrade" = "1" ] && submit_flags+=("-justgrade")
      [ "$submit_verbose" = "1" ] && submit_flags+=("-v")
      [ "$submit_hash_verbose" = "1" ] && submit_flags+=("-vh")
      if [ ${#extra_make_args[@]} -gt 0 ]; then
        submit_flags+=("${extra_make_args[@]}")
      fi
      assignments=()
      while IFS= read -r hw; do
        [ -n "$hw" ] && assignments+=("$hw")
      done < <(ls -d "$REPO_ROOT/assignments"/hw[0-9][0-9] 2>/dev/null | xargs -n1 basename | sort)
      if [ ${#assignments[@]} -eq 0 ]; then
        echo "[submit] no assignments found under $REPO_ROOT/assignments" >&2
        exit 1
      fi
      rc=0
      for hw in "${assignments[@]}"; do
        if [ ${#submit_flags[@]} -gt 0 ]; then
          "$REPO_ROOT/run" submit "${submit_flags[@]}" "$hw" || rc=$?
        else
          "$REPO_ROOT/run" submit "$hw" || rc=$?
        fi
        echo
      done
      exit $rc
    fi
    # Normalize hw number (accept hw1 or hw01)
    case "$assignment_arg" in
      hw[0-9]) assignment_arg=$(printf "hw%02d" "${assignment_arg#hw}") ;;
    esac
    if [ ${#extra_make_args[@]} -gt 0 ]; then
      set -- "$assignment_arg" "${extra_make_args[@]}"
    else
      set -- "$assignment_arg"
    fi
    # Run submit inside the container first.
    docker run --rm $DOCKER_PLATFORM_FLAG ${TTY_OPTS[@]+"${TTY_OPTS[@]}"} -v "$REPO_ROOT:/repo" ${SOCK_OPTS[@]+"${SOCK_OPTS[@]}"} -w /repo \
      -e HOST_REPO_ROOT="$REPO_ROOT" -e NOGRADE="$nograde" -e JUSTGRADE="$justgrade" -e AG_VERBOSE="$submit_verbose" -e AG_HASH_VERBOSE="$submit_hash_verbose" \
      -e MAKEFLAGS="--no-print-directory -s" "$IMAGE_NAME" make "$target" "$@"
    rc=$?
    if [ $rc -ne 0 ]; then
      exit $rc
    fi
    # Host-side autograder run unless -nograde
    if [ "$nograde" = "1" ]; then
      echo "[submit] host autograder skipped (nograde)"
      exit 0
    fi
    # Normalize hw number (accept hw1 or hw01)
    case "$assignment_arg" in
      hw[0-9]) assignment_arg=$(printf "hw%02d" "${assignment_arg#hw}") ;;
    esac
    marker_path="$REPO_ROOT/assignments/$assignment_arg/.last_submit_zip"
    if [ ! -f "$marker_path" ]; then
      echo "[submit] marker file not found for host autograder: $marker_path" >&2
      exit 1
    fi
    rel_entry=$(cat "$marker_path")
    zip_name="${rel_entry##*/}"
    grader_dir="$REPO_ROOT/assignments/$assignment_arg/Gradescope_Autograder_Template"
    if [ ! -d "$grader_dir" ]; then
      echo "[submit] Gradescope_Autograder_Template not found for $assignment_arg; skipping host autograder." >&2
      exit 1
    fi
    echo "[submit] running host autograder..."
    (cd "$grader_dir" && AG_VERBOSE="$submit_verbose" AG_HASH_VERBOSE="$submit_hash_verbose" ./run grade "test_submissions/$zip_name")
    grade_rc=$?
    turnin_path="generated_turnins/$assignment_arg/$zip_name"
    if [ -f "$REPO_ROOT/$turnin_path" ]; then
      echo "-------------------------------"
      echo "[submit] submission zip ready:"
      echo "  $turnin_path"
      echo "-------------------------------"
    else
      echo "-------------------------------"
      echo "[submit] submission zip ready:"
      echo "  assignments/$assignment_arg/Gradescope_Autograder_Template/test_submissions/$zip_name"
      echo "-------------------------------"
    fi
    echo "[submit] cleaning autograder artifacts..."
    (cd "$grader_dir" && make clean >/dev/null 2>&1 || true)
    exit $grade_rc
    ;;
  clean)
    shift
    clean_target="${1:-all}"
    case "$clean_target" in
      logs)      make_target="clean_logs" ;;
      docker)    make_target="clean_docker" ;;
      turnins)   make_target="clean_turnins" ;;
      student)   make_target="clean_student_name" ;;
      ta)        make_target="clean_ta" ;;
      all)       make_target="clean" ;;
      *) echo "Usage: ./run clean [logs|docker|turnins|student|ta|all]" >&2; exit 1 ;;
    esac
    shift || true
    exec make "$make_target" "$@"
    ;;
  student_name|wave_test)
    target="$1"; shift
    exec docker run --rm $DOCKER_PLATFORM_FLAG ${TTY_OPTS[@]+"${TTY_OPTS[@]}"} -v "$REPO_ROOT:/repo" ${SOCK_OPTS[@]+"${SOCK_OPTS[@]}"} -e HOST_REPO_ROOT="$REPO_ROOT" -w /repo "$IMAGE_NAME" make "$target" "$@"
    ;;
esac

if [ "${1:-}" = "student" ]; then
  shift
  subcmd="${1:-}"
  shift || true
  case "$subcmd" in
    "")
      current_name="$(get_student_name_host)"
      current_id="$(get_student_id_host)"
      echo "Student report"
      echo "--------------"
      if [ -n "$current_name" ]; then
        echo "Name: $current_name"
      else
        echo "Name: (not set)"
      fi
      if [ -n "$current_id" ]; then
        echo "ID:   $current_id"
      else
        echo "ID:   (not set)"
      fi
      echo ""
      echo "Commands:"
      echo "  ./run student name <value>"
      echo "  ./run student id <value>"
      exit 0
      ;;
    name)
      if [ $# -gt 0 ]; then
        ensure_config_writable "$CONFIG_FILE_HOST"
        set_student_name_host "$*"
        echo "Student name set: $*"
      else
        current_name="$(get_student_name_host)"
        if [ -n "$current_name" ]; then
          echo "Student name: $current_name"
        else
          echo "Student name not set."
        fi
      fi
      exit 0
      ;;
    id)
      if [ $# -gt 0 ]; then
        ensure_config_writable "$CONFIG_FILE_HOST"
        set_student_id_host "$*"
        echo "Student ID set: $*"
      else
        current_id="$(get_student_id_host)"
        if [ -n "$current_id" ]; then
          echo "Student ID: $current_id"
        else
          echo "Student ID not set."
        fi
      fi
      exit 0
      ;;
    *)
      echo "Usage: ./run student <name|id> [value]" >&2
      exit 1
      ;;
  esac
fi

ensure_student_name() {
  # Uses container python, so call after image exists.
  local preset_name="${1:-}"
  if [ -n "$preset_name" ]; then
    docker run --rm $DOCKER_PLATFORM_FLAG -v "$REPO_ROOT:/repo" -w /repo "$IMAGE_NAME" python3 "$CONFIG_SCRIPT_CONT" --config "$CONFIG_FILE_CONT" set --name "$preset_name"
    echo "Recorded student name: $preset_name"
    return
  fi
  current_name="$(docker run --rm $DOCKER_PLATFORM_FLAG -v "$REPO_ROOT:/repo" -w /repo "$IMAGE_NAME" python3 "$CONFIG_SCRIPT_CONT" --config "$CONFIG_FILE_CONT" current 2>/dev/null || true)"
  if [ -n "$current_name" ]; then
    echo "Student name: $current_name"
    return
  fi
  printf "Enter your name (for submissions): "
  read -r new_name
  if [ -z "$new_name" ]; then
    echo "Name cannot be empty." >&2
    exit 1
  fi
  docker run --rm $DOCKER_PLATFORM_FLAG -v "$REPO_ROOT:/repo" -w /repo "$IMAGE_NAME" python3 "$CONFIG_SCRIPT_CONT" --config "$CONFIG_FILE_CONT" set --name "$new_name"
  echo "Recorded student name: $new_name"
}

if [ "${1:-}" = "setup" ]; then
  shift
  preset_name=""
  existing_name="$(get_student_name_host)"
  if [ -n "$existing_name" ]; then
    echo "Student name: $existing_name"
    printf "Change name? [y/N]: "
    read -r change_name
    case "$change_name" in
      y|Y|yes|YES)
        ;;
      *)
        preset_name="$existing_name"
        ;;
    esac
  fi
  if [ -z "$preset_name" ]; then
    while [ -z "$preset_name" ]; do
      printf "Enter your name (for submissions): "
      read -r preset_name
      if [ -z "$preset_name" ]; then
        echo "Name cannot be empty." >&2
      fi
    done
  fi
  ensure_config_writable "$CONFIG_FILE_HOST"
set_student_name_host "$preset_name"
  while [ $# -gt 0 ]; do
    case "$1" in
      --test-force=*)
        TEST_FORCE="${1#*=}"
        ;;
      *)
        echo "Unknown setup option: $1" >&2
        exit 1
        ;;
    esac
    shift
  done
  ensure_openconnect_host() {
    local os
    local update_available="false"
    local install_needed="false"
    local update_needed="false"
    local update_choice=""
    local deps_list=()
    os="$(uname -s 2>/dev/null || true)"
    if [ "$os" = "Darwin" ]; then
      if ! command -v brew >/dev/null 2>&1; then
        echo "[setup] openconnect: Homebrew not found; skipping host install." >&2
        return 0
      fi
      if ! brew list openconnect >/dev/null 2>&1; then
        install_needed="true"
      else
        if brew outdated --quiet openconnect 2>/dev/null | grep -q '^openconnect$'; then
          update_available="true"
        fi
      fi
      if [ "$update_available" = "true" ]; then
        printf "[setup] openconnect update available. Update? [y/N] (15s timeout): "
        if read -r -t 15 update_choice; then
          case "$update_choice" in
            y|Y|yes|YES) update_needed="true" ;;
            *) ;;
          esac
        fi
      fi
      if [ "$install_needed" = "true" ]; then
        deps_list+=("openconnect (install)")
      elif [ "$update_needed" = "true" ]; then
        deps_list+=("openconnect (update)")
      fi
      if [ ${#deps_list[@]} -gt 0 ]; then
        echo "[setup] Host dependencies will be installed/updated:"
        printf "  - %s\n" "${deps_list[@]}"
        echo "[setup] Installing/updating via Homebrew..."
        brew update >/dev/null 2>&1 || true
        if [ "$install_needed" = "true" ]; then
          brew install openconnect
        elif [ "$update_needed" = "true" ]; then
          brew upgrade openconnect || true
        fi
      else
        echo "[setup] Host dependencies are up to date."
      fi
      return 0
    fi
    if [ -n "${WSL_INTEROP:-}" ] || grep -qi microsoft /proc/version 2>/dev/null; then
      if ! dpkg -s openconnect >/dev/null 2>&1; then
        install_needed="true"
      else
        if apt-cache policy openconnect 2>/dev/null | awk '
          $1 == "Installed:" {installed=$2}
          $1 == "Candidate:" {candidate=$2}
          END {exit (installed != "" && candidate != "" && installed != candidate) ? 0 : 1}
        '; then
          update_available="true"
        fi
      fi
      if [ "$update_available" = "true" ]; then
        printf "[setup] openconnect update available. Update? [y/N] (15s timeout): "
        if read -r -t 15 update_choice; then
          case "$update_choice" in
            y|Y|yes|YES) update_needed="true" ;;
            *) ;;
          esac
        fi
      fi
      if [ "$install_needed" = "true" ]; then
        deps_list+=("openconnect (install)")
      elif [ "$update_needed" = "true" ]; then
        deps_list+=("openconnect (update)")
      fi
      if [ ${#deps_list[@]} -gt 0 ]; then
        echo "[setup] Host dependencies will be installed/updated:"
        printf "  - %s\n" "${deps_list[@]}"
        echo "[setup] Passwords are not saved."
        if command -v sudo >/dev/null 2>&1; then
          sudo -v
          sudo apt-get update
          if [ "$install_needed" = "true" ]; then
            sudo apt-get install -y openconnect
          elif [ "$update_needed" = "true" ]; then
            sudo apt-get install -y openconnect
          fi
        else
          echo "[setup] openconnect: sudo not found; skipping host install." >&2
        fi
      else
        echo "[setup] Host dependencies are up to date."
      fi
      return 0
    fi
    echo "============================================================" >&2
    echo "[setup] WARNING: unsupported host platform." >&2
    echo "[setup] Some dependencies were not installed." >&2
    echo "[setup] The environment may not be fully set up." >&2
    echo "============================================================" >&2
  }
  ensure_openconnect_host
  if [ -f "$REPO_ROOT/assignments/tools/assembler/assemble.sh" ]; then
    chmod +x "$REPO_ROOT/assignments/tools/assembler/assemble.sh"
  fi
  if [ -f "$REPO_ROOT/assignments/tools/simulator/wiscalculator" ]; then
    chmod +x "$REPO_ROOT/assignments/tools/simulator/wiscalculator"
  fi
  echo "Building Docker image '$IMAGE_NAME'..."
  if [ -n "$DOCKER_PLATFORM_FLAG" ]; then
    if docker buildx version >/dev/null 2>&1; then
      docker buildx build --platform linux/amd64 --load -t "$IMAGE_NAME" -f "$REPO_ROOT/docker/Dockerfile" "$REPO_ROOT"
    else
      echo "Error: docker buildx not available; cannot build amd64 image." >&2
      echo "Enable Buildx:" >&2
      echo "  docker buildx create --use --name cs147-builder" >&2
      echo "  docker buildx inspect --bootstrap" >&2
      exit 1
    fi
  else
    docker build -t "$IMAGE_NAME" -f "$REPO_ROOT/docker/Dockerfile" "$REPO_ROOT"
  fi
  echo "Docker image '$IMAGE_NAME' is ready."
  ensure_student_name "$preset_name"
  if [ -f "$REPO_ROOT/assignments/tools/assembler/Assemble.java" ]; then
    echo "Compiling assembler classes..."
    docker run --rm $DOCKER_PLATFORM_FLAG -v "$REPO_ROOT:/repo" -w /repo "$IMAGE_NAME" bash -lc "cd /repo/assignments/tools/assembler && javac Assemble.java AssemblyLine.java Assemble4096.java"
  fi
  echo "------------------------------------------------------------"
  echo "[SELF-TEST] .testing"
  echo "============================================================"
  mkdir -p "$SELFTEST_LOG_DIR"
  attempt=1
  set +e  # allow retries even when commands fail inside the loop
  while [ $attempt -le 3 ]; do
    echo "---------------- attempt $attempt/3 ----------------"
    log_file="$SELFTEST_LOG_DIR/.testing_selftest_attempt${attempt}.log"
    if run_with_spinner "Self-test attempt $attempt" bash -c "docker run --rm $DOCKER_PLATFORM_FLAG -v \"$REPO_ROOT:/repo\" ${DOCKER_SOCK_VOLUME[*]} -w /repo \"$IMAGE_NAME\" bash -lc \"set -e; make submit .testing ${TEST_FORCE:+FORCE_RESULT=\\\"$TEST_FORCE\\\"}\" >\"$log_file\" 2>&1"; then
      cat "$log_file"
      echo "============================================================"
      echo "[SELF-TEST] PASS"
      echo "------------------------------------------------------------"
      exit 0
    else
      if [ $attempt -lt 3 ]; then
        echo "(attempt $attempt failed; output saved to $log_file)"
      else
        cat "$log_file"
      fi
    fi
    echo "---------------- end attempt $attempt ----------------"
    attempt=$((attempt+1))
  done
  set -e
  echo "============================================================"
  echo "[SELF-TEST] FAIL after 3 attempts. Please contact the instructor."
  if ls "$SELFTEST_LOG_DIR"/.testing_selftest_attempt*.log >/dev/null 2>&1; then
    echo "Saved logs:"
    ls -1 "$SELFTEST_LOG_DIR"/.testing_selftest_attempt*.log
    zip_path="$SELFTEST_LOG_DIR/selftest_logs.zip"
    if command -v zip >/dev/null 2>&1; then
      rm -f "$zip_path"
      (cd "$SELFTEST_LOG_DIR" && zip -q "selftest_logs.zip" .testing_selftest_attempt*.log >/dev/null 2>&1)
      if [ -f "$zip_path" ]; then
        echo "Log bundle: $zip_path"
      fi
    fi
  fi
  echo "------------------------------------------------------------"
  exit 1
fi

if ! docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
  echo "Error: Docker image '$IMAGE_NAME' not found. Run './run setup' first." >&2
  exit 1
fi

if [ $# -eq 0 ]; then
  set -- shell
fi

if [ "$1" = "shell" ]; then
  shift
  exec docker run --rm $DOCKER_PLATFORM_FLAG "${TTY_FLAGS[@]}" -v "$REPO_ROOT:/repo" "${DOCKER_SOCK_VOLUME[@]}" -w "$WORKDIR" "$IMAGE_NAME" bash "$@"
fi

exec docker run --rm $DOCKER_PLATFORM_FLAG "${TTY_FLAGS[@]}" -v "$REPO_ROOT:/repo" "${DOCKER_SOCK_VOLUME[@]}" -w "$WORKDIR" "$IMAGE_NAME" "$@"
